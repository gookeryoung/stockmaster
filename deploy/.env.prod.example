# ═══════════════════════════════════════════════════════════════════
# StockMaster 生产环境变量模板
#
# 用法：在服务器仓库根目录 cp deploy/.env.prod.example .env && vim .env
# 该文件含运行期配置，务必不在 git 追踪中（.gitignore / .dockerignore 均已排除 .env）
# ═══════════════════════════════════════════════════════════════════

# ── 镜像与端口 ────────────────────────────────────────────────
# 镜像地址：deploy.sh 每次部署会按版本号自动覆写这一行，手工改版本号无意义
SM_IMAGE=stockmaster:v0.1.4
# 对外绑定。同机已有服务占用 80/443 时，这里用独立端口
SM_BIND=0.0.0.0:8770
# 数据卷名（换机器迁移时保持同名可直接挂载旧数据）
SM_VOLUME=stockmaster-data

# ── 服务行为 ──────────────────────────────────────────────────
SM_LOG_LEVEL=INFO
# 内置调度器：收盘后自动同步 + 预警巡检。同机只能跑一个实例时保持 true
SM_SCHEDULER_ENABLED=true
# 数据源优先级，主源不可用自动降级
SM_PROVIDER_ORDER=baostock,tencent,sina
# baostock 并发敏感，建议不超过 4
SM_SYNC_WORKERS=4

# ── 预警外发（可选）───────────────────────────────────────────
# 通用 webhook 地址，留空即关闭网络通知（页面内预警照常工作）
SM_ALERT_WEBHOOK_URL=
