# ═══════════════════════════════════════════════════════════════════
# StockMaster 生产环境变量模板
#
# 用法：在服务器仓库根目录 cp deploy/.env.prod.example .env && vim .env
# 该文件含运行期配置，务必不在 git 追踪中（.gitignore / .dockerignore 均已排除 .env）
# ═══════════════════════════════════════════════════════════════════

# ── 镜像与端口 ────────────────────────────────────────────────
# 镜像地址：deploy.sh 每次部署会按版本号自动覆写这一行，手工改版本号无意义
SM_IMAGE=stockmaster:v0.1.4
# 对外绑定。同机已有服务占用 80/443 时，这里用独立端口
SM_BIND=0.0.0.0:8770
# 数据卷名（换机器迁移时保持同名可直接挂载旧数据）
SM_VOLUME=stockmaster-data

# ── 服务行为 ──────────────────────────────────────────────────
SM_LOG_LEVEL=INFO
# 内置调度器：收盘后自动同步 + 预警巡检。同机只能跑一个实例时保持 true
SM_SCHEDULER_ENABLED=true
# 数据源优先级，主源不可用自动降级
SM_PROVIDER_ORDER=baostock,tencent,sina
# baostock 并发敏感，建议不超过 4
SM_SYNC_WORKERS=4

# ── 预警外发（可选）───────────────────────────────────────────
# 通用 webhook 地址，留空即关闭网络通知（页面内预警照常工作）
SM_ALERT_WEBHOOK_URL=

# ── 账号与微信登录（可选）─────────────────────────────────────
# false=接口开放（单机直连）；true=除登录/健康检查外全部要求登录
SM_AUTH_ENABLED=false
# 留空则自动生成并写入 /data/.auth_secret。多实例部署必须显式配置同一个值，
# 否则各实例签发的令牌互不通用。更换该值 = 让所有已登录会话立即失效。
SM_AUTH_SECRET_KEY=
# 是否允许自助注册（首个注册账号自动成为管理员）
SM_AUTH_ALLOW_REGISTER=true
# 启动时确保存在的管理员（幂等；密码只在账号不存在时写入，不会覆盖已有密码）
SM_ADMIN_USERNAME=
SM_ADMIN_PASSWORD=
# 微信登录模式：open=网站应用扫码 / mp=公众号网页授权 / mock=本地模拟 / off=关闭
SM_WECHAT_LOGIN_MODE=off
SM_WECHAT_APP_ID=
SM_WECHAT_APP_SECRET=
# 与微信平台登记的授权回调完全一致，例如
# https://stock.gookeryoung.cn/api/v1/auth/wechat/callback
SM_WECHAT_REDIRECT_URI=
# 扫码回调后跳回的 SPA 地址，同源部署留空即可
SM_AUTH_FRONTEND_BASE=
# 自选股 / 预警 / 回测历史按工作区隔离（owner/editor/viewer 角色，见 docs/WORKSPACE.md）。
# false = 沿用「所有人共享一份」的旧语义，单人使用保持 false；团队协作时置 true
# （历史数据已按用户回填个人工作区，无主数据用 `workspace claim` 移交）
SM_DATA_ISOLATION=false

# ── 数据库迁移与备份 ────────────────────────────────────────
# 启动时自动迁移到最新 schema；false 表示要求先手动 `db upgrade`
SM_DB_AUTO_MIGRATE=true
# 本地备份保留份数（数据卷内 /data/backups），0 不清理
SM_BACKUP_KEEP=7
# 备份是否包含令牌签名密钥。包含才能「整体回到过去」，但归档等同凭据
SM_BACKUP_INCLUDE_SECRET=true

# ── HTTPS（可选，见 deploy/setup-tls.sh）──────────────────────
# 子域名，需先在 DNSPod 加 A 记录指向本机公网 IP，再用 setup-tls.sh 签发
SM_TLS_DOMAIN=stock.gookeryoung.cn
# Let's Encrypt 注册邮箱（留空则用 --register-unsafely-without-email，收不到到期提醒）
SM_ACME_EMAIL=
# uvicorn 信任的反代来源；走 nginx 反代时需放开，否则客户端 IP 会记成容器 IP
FORWARDED_ALLOW_IPS=*
