# ═══════════════════════════════════════════════════════════════════
# StockMaster 生产镜像（服务器本地构建，镜像不过网）
#
# 两阶段：
#   1) node 阶段构建前端 SPA → frontend/dist
#   2) python 阶段装后端运行期依赖，由 FastAPI 同源托管 SPA + API
#
# 基础镜像统一走腾讯云内网源：国内服务器直连 Docker Hub 会超时。
# 换源：docker build --build-arg BASE_REGISTRY=<镜像源前缀>/library .
#
# 路径约定（改之前先想清楚）：
#   backend/app/config.py 里 REPO_ROOT = parents[2] = /app，
#   前端产物必须落在 /app/frontend/dist，否则后端判定 SPA 未构建而进入 API-only 模式。
# ═══════════════════════════════════════════════════════════════════
ARG BASE_REGISTRY=mirror.ccs.tencentyun.com/library

# ── 阶段 1：前端构建 ────────────────────────────────────────────────
FROM ${BASE_REGISTRY}/node:22-alpine AS frontend-build
ENV NPM_CONFIG_REGISTRY=https://registry.npmmirror.com \
    NPM_CONFIG_FUND=false \
    NPM_CONFIG_AUDIT=false
WORKDIR /build/frontend
# 先只拷依赖清单命中层缓存；lock 与 package.json 失配时 --frozen-lockfile 直接失败，
# 而不是静默重新解析（避免线上产物与本地/CI 不一致）。
COPY frontend/package.json frontend/pnpm-lock.yaml frontend/pnpm-workspace.yaml ./
RUN npm install -g pnpm && pnpm install --frozen-lockfile
COPY frontend/ ./
RUN pnpm build

# ── 阶段 2：运行时 ─────────────────────────────────────────────────
FROM ${BASE_REGISTRY}/python:3.13-slim AS runtime
# LANG/LC_ALL 必须显式设为 UTF-8：slim 镜像默认 POSIX locale，
# 中文日志与 CLI 输出会抛 UnicodeEncodeError。
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PIP_NO_CACHE_DIR=1 \
    PIP_INDEX_URL=https://mirrors.cloud.tencent.com/pypi/simple \
    PIP_TRUSTED_HOST=mirrors.cloud.tencent.com \
    UV_INDEX_URL=https://mirrors.cloud.tencent.com/pypi/simple \
    UV_TRUSTED_HOST=mirrors.cloud.tencent.com \
    UV_LINK_MODE=copy \
    UV_PYTHON_PREFERENCE=only-system \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PYTHONPATH=/app/backend \
    PATH=/opt/venv/bin:/usr/local/bin:/usr/bin:/bin

WORKDIR /app

# 装运行期依赖：只装 pyproject 的基础依赖，dev/test/docs 额外组一律不装
RUN pip install --no-cache-dir uv
COPY pyproject.toml uv.lock README.md ./
COPY backend/ ./backend/
RUN uv sync --frozen --no-install-project

# 前端产物落到 REPO_ROOT/frontend/dist（见文件头路径约定）
COPY --from=frontend-build /build/frontend/dist ./frontend/dist

# 数据（SQLite 库 + 模型产物）统一落 /data 卷，容器重建不丢数据
ENV SM_HOST=0.0.0.0 \
    SM_PORT=8770 \
    SM_DATA_DIR=/data
VOLUME ["/data"]
EXPOSE 8770

# 镜像内没有 curl，用标准库探测，与 docker-compose.prod.yml 的 healthcheck 一致
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
    CMD python -c "import urllib.request as u; u.urlopen('http://127.0.0.1:8770/api/v1/health', timeout=5)" || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8770"]
