# StockMaster configuration — copy to .env and adjust as needed.

# --- Server ---
SM_HOST=127.0.0.1
SM_PORT=8770
SM_LOG_LEVEL=INFO

# --- Storage ---
# Relative paths resolve against the repository root.
SM_DATA_DIR=data
SM_DB_FILENAME=stockmaster.db

# --- Data providers ---
# Priority order; first healthy source wins, others act as fallback.
SM_PROVIDER_ORDER=baostock,tencent,sina
# Seconds before a provider request is considered hung and aborted.
SM_PROVIDER_TIMEOUT=30
SM_PROVIDER_MAX_RETRIES=3
# Consecutive failures before a provider is circuit-broken.
SM_PROVIDER_CIRCUIT_THRESHOLD=3
SM_PROVIDER_CIRCUIT_COOLDOWN=300
# Concurrent fetch workers for bulk sync (baostock is connection-sensitive; keep low).
SM_SYNC_WORKERS=4
# Politeness delay between requests, seconds.
SM_SYNC_REQUEST_DELAY=0.05

# --- Analysis / prediction ---
# Default forward horizons in trading days.
SM_PREDICT_HORIZONS=1,5,20
# Fraction of the (time-ordered) dataset reserved for the out-of-sample test set.
SM_TEST_FRACTION=0.2
# Random seed for reproducible model training.
SM_RANDOM_SEED=42

# --- Alerts ---
SM_ALERT_POLL_SECONDS=60
# Generic outbound webhook; leave empty to disable network notifications.
SM_ALERT_WEBHOOK_URL=

# --- Scheduler ---
# Enable the in-process APScheduler jobs.
SM_SCHEDULER_ENABLED=true
# IANA timezone used for all market-time scheduling.
SM_TIMEZONE=Asia/Shanghai

# --- Accounts / authentication ---
# false = API stays open (single-machine mode); true = login required everywhere
# except /health and the auth endpoints themselves.
SM_AUTH_ENABLED=false
# HS256 signing key. Leave empty to auto-generate one into <data dir>/.auth_secret.
# Multi-instance deployments must set the same explicit value everywhere.
SM_AUTH_SECRET_KEY=
# Access-token lifetime in minutes (default 7 days).
SM_AUTH_TOKEN_TTL_MINUTES=10080
# Allow self-registration; the very first account becomes the administrator.
SM_AUTH_ALLOW_REGISTER=true
# Bootstrap administrator, created on startup when missing (password only applies
# to a newly created account, never overwritten).
SM_ADMIN_USERNAME=
SM_ADMIN_PASSWORD=
# Public SPA origin used for post-login redirects. Leave empty when the API and UI
# share an origin; set it to http://127.0.0.1:5173 when running `make dev`.
SM_AUTH_FRONTEND_BASE=
# Isolate watchlists / alert rules / backtest history per account. false keeps the
# historical "everyone shares one dataset" behaviour; true makes each account see
# only its own rows (legacy rows with owner_id=0 stay in the unassigned bucket).
SM_DATA_ISOLATION=false

# --- WeChat login ---
# open = 网站应用扫码 (open.weixin.qq.com), mp = 公众号网页授权,
# mock = 本地模拟授权（无凭证，演练全流程）, off = 关闭
SM_WECHAT_LOGIN_MODE=off
SM_WECHAT_APP_ID=
SM_WECHAT_APP_SECRET=
# Must match the callback registered on the WeChat platform exactly.
# e.g. https://stock.gookeryoung.cn/api/v1/auth/wechat/callback
SM_WECHAT_REDIRECT_URI=

# --- Migrations / backups ---
# Startup auto-migration (create_all + alembic). Set false to require an explicit
# `stockmaster db upgrade` before rollout; a stale schema is then logged loudly.
SM_DB_AUTO_MIGRATE=true
# Local backup retention (<data dir>/backups), 0 disables pruning.
SM_BACKUP_KEEP=7
# Include the token signing key in archives. Required for a faithful "roll back in
# time", but the archive then has the same sensitivity as the key itself.
SM_BACKUP_INCLUDE_SECRET=true

# --- Console output ---
# Leave empty to auto-detect the terminal code page (GBK console vs UTF-8 terminal).
# Set explicitly when auto-detection is wrong, e.g. in CI logs: utf-8
SM_CONSOLE_ENCODING=